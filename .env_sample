# ===========================================================================
# AMG Multimodal RAG — Environment Configuration Sample
# ===========================================================================
# Copy this file to .env and adjust values for your environment.
# All parameters below reflect available settings in the system with their
# respective code-level defaults provided as commented values.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. System, Storage & Logging
# ---------------------------------------------------------------------------
# Global logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Compute device selection: auto, cuda, cpu, cuda:0, etc.
DEVICE=auto

# Base directory for local file persistence
DATA_DIR=./data

# SQLite document/version registry database path
REGISTRY_DB_PATH=./data/ingestion_registry.db

# Permanent storage directory for uploaded/ingested PDF documents
PDF_DIR=./data/pdfs

# Storage directory for rendered page PNG images
PAGE_IMAGE_DIR=./data/pages

# Storage directory for dummy test files
DUMMY_DIR=./data/dummy


# ---------------------------------------------------------------------------
# 2. FastAPI Web Service (api.py)
# ---------------------------------------------------------------------------
# HTTP port for the FastAPI application server
API_PORT=8000

# SQLite database path for async ingestion jobs
API_JOB_DB_PATH=./data/ingestion_jobs.db

# Temporary directory for API job downloads and file staging
API_JOB_DATA_DIR=./data/api_jobs

# Maximum number of files permitted in a single ingestion request
API_MAX_FILES_PER_REQUEST=20

# Network timeout (in seconds) when downloading PDF sources from S3
S3_DOWNLOAD_TIMEOUT=120

# Maximum allowed file size (in megabytes) for S3 PDF downloads
S3_MAX_FILE_SIZE_MB=512

# Optional comma-separated list of allowed S3 hosts (e.g. bucket.s3.amazonaws.com)
S3_ALLOWED_HOSTS=

# SQLite database path for async query retrieval jobs
QUERY_JOB_DB_PATH=./data/query_jobs.db

# Directory for detailed JSON query execution and audit logs
QUERY_LOG_DIR=./data/query

# SQLite database path for async generation jobs
GENERATE_JOB_DB_PATH=./data/generate_jobs.db

# Directory for detailed JSON generation execution and audit logs
GENERATE_LOG_DIR=./data/generate


# ---------------------------------------------------------------------------
# 3. Qdrant Vector Database & Container Automation (docker_manager.py)
# ---------------------------------------------------------------------------
# Qdrant REST API base URL (Set to http://qdrant:6333 when running inside Docker Compose)
QDRANT_URL=http://localhost:6333

# Optional Qdrant API key for authenticated access
QDRANT_API_KEY=

# Qdrant target collection name
QDRANT_COLLECTION=personal_collection

# Vector field name used for multi-vector late-interaction embeddings
QDRANT_VECTOR_NAME=page_embedding

# Name assigned to the managed Qdrant Docker container
QDRANT_CONTAINER_NAME=amg-qdrant

# Docker image used for running Qdrant
QDRANT_IMAGE=qdrant/qdrant:latest

# Persistent Docker volume name for Qdrant database files
QDRANT_STORAGE_VOLUME=amg_qdrant_storage

# Host IP binding for Qdrant HTTP service
QDRANT_HTTP_HOST=127.0.0.1

# Host port binding for Qdrant HTTP service
QDRANT_HTTP_PORT=6333

# Host IP binding for Qdrant gRPC service
QDRANT_GRPC_HOST=127.0.0.1

# Host port binding for Qdrant gRPC service
QDRANT_GRPC_HOST_PORT=6334

# Maximum timeout (seconds) to wait for Docker daemon startup
QDRANT_DOCKER_START_TIMEOUT=120

# Maximum timeout (seconds) to wait for Qdrant REST API readiness
QDRANT_API_READY_TIMEOUT=60

# Automatically launch Docker Desktop via systemctl if daemon is offline
QDRANT_START_DOCKER_DESKTOP=true

# Batch size for points upserted to Qdrant during ingestion
QDRANT_UPSERT_BATCH_SIZE=8


# ---------------------------------------------------------------------------
# 4. Redis Cache & Coordination (redis_manager.py)
# ---------------------------------------------------------------------------
# Redis server host address (Set to redis when running inside Docker Compose)
REDIS_HOST=127.0.0.1

# Redis server host port (default 6380 on host; 6379 when inside Docker network)
REDIS_PORT=6380

# Logical Redis database index
REDIS_DB=0

# Optional Redis connection password
REDIS_PASSWORD=

# Docker container name for Redis
REDIS_CONTAINER_NAME=amg-redis

# Docker image used for running Redis
REDIS_IMAGE=redis:7-alpine

# Persistent Docker volume name for Redis state
REDIS_VOLUME=amg_redis_data

# Timeout (seconds) for Docker daemon readiness when auto-starting Redis container
DOCKER_START_TIMEOUT=120

# Socket connection timeout (seconds) for Redis commands
REDIS_CONNECT_TIMEOUT=2.0

# Time-to-live (seconds) for query retrieval and answer generation caches (10 mins)
REDIS_CACHE_TTL=600

# Time-to-live (seconds) for fast job state polling cache (3 days)
REDIS_JOB_TTL=259200

# Time-to-live (seconds) for completed idempotency records (24 hours)
REDIS_IDEMPOTENCY_TTL=86400

# Reservation window (seconds) for pending idempotency locks (2 mins)
REDIS_IDEMPOTENCY_RESERVATION_TTL=120


# ---------------------------------------------------------------------------
# 5. ColPali Ingestion & Retrieval Model (ingest.py, query.py)
# ---------------------------------------------------------------------------
# Hugging Face model identifier for ColPali
COLPALI_MODEL=vidore/colpali-v1.3-merged

# Hugging Face model revision branch/tag
COLPALI_MODEL_REVISION=main

# Restrict Hugging Face model loading strictly to local cache without internet lookups
HF_LOCAL_FILES_ONLY=false

# Quantization precision: 4bit, 8bit, or none
QUANTIZATION=4bit

# BitsAndBytes 4-bit quantization type: nf4 or fp4
BNB_4BIT_QUANT_TYPE=nf4

# Compute data type for 4-bit operations: bfloat16, float16, float32
BNB_4BIT_COMPUTE_DTYPE=bfloat16

# Enable nested double quantization for BitsAndBytes 4-bit
BNB_4BIT_USE_DOUBLE_QUANT=true

# Save locally quantized model weights to disk after quantization
SAVE_QUANTIZED_MODEL=false

# Path to directory containing or storing pre-quantized ColPali weights
QUANTIZED_MODEL_DIR=./models/colpali-v1.3-merged-4bit-nf4

# Rendering resolution DPI for PDF page rasterization to PNG
PDF_DPI=150

# Batch size for embedding pages with ColPali (1 recommended for small VRAM GPUs)
COLPALI_BATCH_SIZE=1

# Extract and store raw text along with images in Qdrant point payloads
STORE_PAGE_TEXT=true


# ---------------------------------------------------------------------------
# 6. Answer Generation & Vision-Language Model (generate.py)
# ---------------------------------------------------------------------------
# Hugging Face model identifier for answer generation VLM
GENERATOR_MODEL=Qwen/Qwen3-VL-2B-Instruct

# Local directory path to generator weights (overrides GENERATOR_MODEL if specified)
GENERATOR_MODEL_PATH=

# Hugging Face model revision branch/tag for generator
GENERATOR_MODEL_REVISION=main

# Load generator model using 4-bit quantization
GENERATOR_USE_4BIT=true

# Flag indicating generator model is already pre-quantized on disk
GENERATOR_PREQUANTIZED=false

# BitsAndBytes 4-bit quantization type for generator: nf4 or fp4
GENERATOR_BNB_4BIT_QUANT_TYPE=nf4

# Enable nested double quantization for generator model
GENERATOR_BNB_4BIT_DOUBLE_QUANT=true

# Compute data type for generator: bfloat16, float16, float32
GENERATOR_BNB_4BIT_COMPUTE_DTYPE=bfloat16

# Attention implementation for generator: sdpa, flash_attention_2, eager
GENERATOR_ATTN_IMPLEMENTATION=sdpa

# GPU memory swapping: unload ColPali retriever before loading generator
GENERATOR_RELEASE_RETRIEVER=true

# GPU memory swapping: unload generator model after completing generation
GENERATOR_RELEASE_AFTER_GENERATION=true

# Force Python garbage collection on model release/transitions
GENERATOR_GC_ON_MODEL_SWITCH=true

# Call torch.cuda.empty_cache() during model transitions
GENERATOR_EMPTY_CUDA_CACHE=true

# Serialize generation requests using a thread lock to prevent GPU VRAM overload
GENERATOR_SERIALIZE=true

# Number of top retrieved pages passed into generation context
GENERATOR_CONTEXT_TOP_K=2

# Maximum number of page images included in multimodal prompt
GENERATOR_MAX_IMAGES=1

# Include page visual images in generation prompt
GENERATOR_INCLUDE_IMAGES=true

# Maximum characters of text context included per page
GENERATOR_MAX_PAGE_TEXT_CHARS=5000

# Maximum aggregate context character budget across all pages
GENERATOR_MAX_TOTAL_CONTEXT_CHARS=12000

# Minimum pixel count for image resizing (controls vision tokens, 256*32*32 ~= 262k)
GENERATOR_MIN_PIXELS=262144

# Maximum pixel count for image resizing (512*32*32 ~= 524k)
GENERATOR_MAX_PIXELS=524288

# Maximum new tokens to generate in answer response
GENERATOR_MAX_NEW_TOKENS=256

# Sampling temperature for answer generation (lower = more deterministic)
GENERATOR_TEMPERATURE=0.1

# Nucleus sampling top-p for answer generation
GENERATOR_TOP_P=0.9


# ---------------------------------------------------------------------------
# 7. Multimodal Reranking (Jina AI jina-reranker-m0)
# ---------------------------------------------------------------------------
# API key for Jina AI (https://jina.ai/reranker/)
JINA_RERANKER_KEY=your_jina_api_key_here
# Alternative environment variable name
JINA_API_KEY=

# Reranker model ID
JINA_RERANKER_MODEL=jina-reranker-m0

# Jina AI reranking REST endpoint
JINA_RERANKER_BASE_URL=https://api.jina.ai/v1/rerank

# HTTP timeout in seconds for Jina API calls
JINA_RERANKER_TIMEOUT_SEC=30

# Enable reranking by default in generation pipeline
GENERATOR_ENABLE_RERANK=false

# Number of initial candidates to retrieve from ColPali before reranking
GENERATOR_RERANK_RETRIEVAL_TOP_K=20

# Relevance score cutoff threshold for reranked candidates (0.0 to 1.0)
GENERATOR_RERANK_THRESHOLD=0.75

# Number of top reranked candidates retained for generation
GENERATOR_RERANK_TOP_K=5


# ---------------------------------------------------------------------------
# 8. Docling & Neo4j Knowledge Graph Integration
# ---------------------------------------------------------------------------
# Master feature flags
DOCLING_ENABLED=true
NEO4J_ENABLED=true
GRAPH_RETRIEVAL_ENABLED=true

# Neo4j Database Connection (Set to bolt://neo4j:7687 when running inside Docker Compose)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=amg_neo4j_password_2026
NEO4J_DATABASE=neo4j
NEO4J_CONNECT_TIMEOUT_SEC=10.0
NEO4J_MAX_CONNECTION_LIFETIME_SEC=3600.0

# Neo4j Managed Container Automation
NEO4J_CONTAINER_NAME=amg-neo4j
NEO4J_IMAGE=neo4j:5-community
NEO4J_VOLUME=amg_neo4j_data
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Docling Parser Configuration
DOCLING_CACHE_DIR=./data/docling_cache
DOCLING_MAX_PAGE_COUNT=0
DOCLING_MAX_CHUNK_CHARS=1200
DOCLING_CHUNK_OVERLAP_CHARS=150

# Graph Extraction Provider (openrouter, local, or none)
GRAPH_EXTRACTOR_PROVIDER=openrouter
GRAPH_EXTRACTOR_MODEL=nvidia/nemotron-3.5-super-vl:free
GRAPH_EXTRACTOR_API_KEY=
GRAPH_EXTRACTOR_BASE_URL=https://openrouter.ai/api/v1
GRAPH_EXTRACTOR_TIMEOUT_SEC=45.0
GRAPH_EXTRACTOR_MAX_RETRIES=3
GRAPH_EXTRACTOR_MAX_CHUNKS_PER_CALL=3

# Graph Retrieval & Traversal Configuration
GRAPH_SEARCH_MAX_HOPS=2
GRAPH_SEARCH_PAGE_LIMIT=10
GRAPH_SEARCH_CLAIM_LIMIT=20
GRAPH_SEARCH_MIN_CONFIDENCE=0.6
